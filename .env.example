# Copy to .env and fill in. Never commit .env.

# Your Virtual Smart Home "URL Routine Trigger" link, the JSON-response variant
# (ends in &response=json). Anyone with this URL can fire your routine, so keep it secret.
TRIGGER_URL=https://www.virtualsmarthome.xyz/url_routine_trigger/activate.php?trigger=...&token=...&response=json

# Optional: phone notifications via ntfy (https://ntfy.sh). Leave NTFY_TOPIC blank to skip.
# The topic name is the only access control, so pick something unguessable.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Optional: 1 = also ntfy on every trigger fire, live-watch start, and each game's verdict.
NTFY_DEBUG=0

# Testing only: watch a different team (ESPN abbreviation, e.g. LAL) to see a win sooner.
TEAM=SAC
