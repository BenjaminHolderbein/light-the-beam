# Copy to .env and fill in. Never commit .env.

# How the bulbs are reached: hue or webhook. Leave it blank and it works out
# which from whatever else is filled in below.
LIGHT_BACKEND=

# ---------------------------------------------------------------- Hue bridge
# Use this if your bulbs are already on a Philips Hue bridge. Nothing here is
# typed by hand: run
#   python -m src.beam --pair-hue <bridge-ip>
# press the round button on top of the bridge, and it writes the next three.
# The bridge's IP is in the Hue app under Settings -> My Hue System -> Bridge.
HUE_BRIDGE=
HUE_KEY=
# SHA-256 of the bridge's certificate, recorded at pairing. The bridge signs
# its own certificate so it can't be verified the usual way; this is what
# stops something else on your network pretending to be it.
HUE_CERT_SHA256=

# Which rooms, zones or bulbs go purple, comma separated, named exactly as the
# Hue app names them. A room or zone changes all at once, which looks better
# than bulbs lighting one after another. See what's available with:
#   python -m src.beam --hue-lights
HUE_TARGETS=

# Optional. Kings purple and full brightness unless you say otherwise.
HUE_COLOR=#5A2D81
HUE_BRIGHTNESS=100
# Seconds of purple before the lights go back to how they were. 0 keeps them
# purple until you change them yourself. A restart during the wait cancels it.
HUE_RESTORE_AFTER=0

# ------------------------------------------------------- Alexa, any bulb brand
# Use this if your bulbs aren't on a Hue bridge. Your Virtual Smart Home "URL
# Routine Trigger" link, the JSON-response variant (ends in &response=json).
# Anyone with this URL can fire your routine, so keep it secret.
TRIGGER_URL=

# Optional: phone notifications via ntfy (https://ntfy.sh). Leave NTFY_TOPIC blank to skip.
# The topic name is the only access control, so pick something unguessable.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Optional: 1 = also ntfy on every trigger fire, live-watch start, and each game's verdict.
NTFY_DEBUG=0

# Testing only: watch a different team (ESPN abbreviation, e.g. LAL) to see a win sooner.
TEAM=SAC
